# Install after foreground account verification; see INSTALL.md.
[Unit]
Description=MiBot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/root/mibot
# Operator must verify this absolute Node 24 binary path.
ExecStart=/usr/bin/node /root/mibot/dist/v2/index.js --serve
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=60s
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mibot

[Install]
WantedBy=multi-user.target
