{
  "schemaVersion": 1,
  "scope": "synthetic listener authorization; not a complete security audit",
  "defaults": {"uid": 101, "cid": 202, "users": [101], "chats": [], "text": ".ping"},
  "cases": [
    {"name": "sudo authorized user with empty chat list", "plugin": "sudo", "send": ".ping", "command": "ping"},
    {"name": "sudo unknown user denied", "plugin": "sudo", "uid": 999},
    {"name": "sudo empty user list denied", "plugin": "sudo", "users": []},
    {"name": "sudo forwarded message denied", "plugin": "sudo", "forwarded": true},
    {"name": "sudo missing sender denied", "plugin": "sudo", "uid": null},
    {"name": "sudo missing chat denied", "plugin": "sudo", "cid": null},
    {"name": "sudo chat outside whitelist denied", "plugin": "sudo", "chats": [303]},
    {"name": "sudo whitelisted chat allowed", "plugin": "sudo", "chats": [202], "send": ".ping", "command": "ping"},
    {"name": "sudo non-command ignored", "plugin": "sudo", "text": "hello"},
    {"name": "sudo custom prefix allowed", "plugin": "sudo", "sudoPrefix": "!", "text": "!ping", "send": "!ping", "command": "ping"},
    {"name": "sudo default prefix not accepted when overridden", "plugin": "sudo", "sudoPrefix": "!"},
    {"name": "sudo topic reply preserved", "plugin": "sudo", "topic": 77, "reply": 88, "send": ".ping", "command": "ping", "replyTo": 77},
    {"name": "sudo ordinary reply preserved", "plugin": "sudo", "reply": 88, "send": ".ping", "command": "ping", "replyTo": 88},
    {"name": "sure empty message whitelist denied", "plugin": "sure"},
    {"name": "sure user whitelist required", "plugin": "sure", "uid": 999, "rules": [{"msg": ".ping"}]},
    {"name": "sure chat whitelist enforced", "plugin": "sure", "chats": [303], "rules": [{"msg": ".ping"}]},
    {"name": "sure forwarded message denied", "plugin": "sure", "forwarded": true, "rules": [{"msg": ".ping"}]},
    {"name": "sure exact message allowed", "plugin": "sure", "text": "hello", "rules": [{"msg": "hello"}], "send": "hello", "deleteDelay": 5000},
    {"name": "sure exact match rejects trailing input", "plugin": "sure", "text": "hello extra", "rules": [{"msg": "hello"}]},
    {"name": "sure command without arguments allowed", "plugin": "sure", "text": "/check", "rules": [{"msg": "_command:/check", "redirect": ".ping"}], "send": ".ping", "command": "ping", "deleteDelay": 5000},
    {"name": "sure command suffix retained", "plugin": "sure", "text": "/check 8.8.8.8", "rules": [{"msg": "_command:/check", "redirect": ".ping"}], "send": ".ping 8.8.8.8", "command": "ping", "deleteDelay": 5000},
    {"name": "sure command prefix collision denied", "plugin": "sure", "text": "/checker", "rules": [{"msg": "_command:/check", "redirect": ".ping"}]},
    {"name": "sure tab is not a command boundary", "plugin": "sure", "text": "/check\t8.8.8.8", "rules": [{"msg": "_command:/check", "redirect": ".ping"}]},
    {"name": "sure first matching rule wins", "plugin": "sure", "text": "hello", "rules": [{"msg": "hello", "redirect": ".ping"}, {"msg": "hello", "redirect": ".help"}], "send": ".ping", "command": "ping", "deleteDelay": 5000},
    {"name": "sure topic reply retained", "plugin": "sure", "text": "hello", "topic": 77, "reply": 88, "rules": [{"msg": "hello"}], "send": "hello", "replyTo": 77, "deleteDelay": 5000},
    {"name": "sure redirect literal dollar", "plugin": "sure", "text": "/check arg", "rules": [{"msg": "_command:/check", "redirect": "$$"}], "send": "$ arg", "deleteDelay": 5000},
    {"name": "sure redirect matched prefix token", "plugin": "sure", "text": "/check arg", "rules": [{"msg": "_command:/check", "redirect": "$&"}], "send": "/check arg", "deleteDelay": 5000},
    {"name": "sure redirect suffix token", "plugin": "sure", "text": "/check arg", "rules": [{"msg": "_command:/check", "redirect": "$'"}], "send": " arg arg", "deleteDelay": 5000},
    {"name": "sure empty replacement result fallback", "plugin": "sure", "text": "/check", "rules": [{"msg": "_command:/check", "redirect": "$`"}], "send": "$`", "deleteDelay": 5000}
  ]
}
